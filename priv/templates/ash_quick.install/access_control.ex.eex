defmodule <%= inspect @module %> do
  @moduledoc """
  Which UI routes a scope may navigate to.

  The single source of truth for route access, and deliberately **not**
  `Ash.can?`: a filter policy allows the action and returns no rows, so `can?`
  says yes for a page that would be empty. `<%= inspect @nav %>` names this
  module, and every rendering of the nav filters through it.
  `AshQuick.LiveView.RouteGate`, in the live session's `on_mount`, asks it on
  every navigation and refuses a route it does not grant.

  As generated it grants nothing. `role/1` reads no role off a scope yet, so
  every scope is answered as `nil` and reaches no route, and a role with no
  `routes_for_role/1` clause of its own reaches none either. Make `role/1` read
  your scope —

      defp role(%MyApp.Scope{current_user: %{role: role}}), do: role
      defp role(_scope), do: nil

  — and give each role a clause listing every route it unlocks, written out in
  full. `mix ash_quick.gen.quick_view MyApp.Catalog.Product --grant-to admin`
  appends the path it routes to the `:admin` clause. Writing each role's routes
  out is what makes adding a route a decision about which roles reach it, and
  leaves a role nobody opened up fail-closed. A new role also goes in `@roles`,
  which `all_routes/0` reads.

  Matching is strict prefix matching: `/products` covers `/products` and
  `/products/123`, but not `/products_archive`. Two routes that mean different
  things must not share a prefix.
  """

  @behaviour AshQuick.AccessControl

  # Every role a `routes_for_role/1` clause grants routes to.
  @roles [:admin]

  @impl AshQuick.AccessControl
  def routes_for(scope), do: scope |> role() |> routes_for_role()

  # The role `scope` holds. Nothing is read yet, so no scope holds one.
  defp role(_scope), do: nil

  @doc """
  Every route `role` may navigate to. A role without a clause gets none.
  """
  def routes_for_role(:admin), do: []
  def routes_for_role(_role), do: []

  @doc """
  Every route any role at all can reach, for `mix ash_quick.check`.
  """
  @impl AshQuick.AccessControl
  def all_routes, do: @roles |> Enum.flat_map(&routes_for_role/1) |> Enum.uniq()
end
